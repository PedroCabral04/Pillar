@using erp.DTOs.ServiceOrders
@using erp.Services
@using erp.Components.Shared
@using MudBlazor
@using Size = MudBlazor.Size
@using Color = MudBlazor.Color

@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<ServiceOrderEditDialog> Logger

<MudDialog>
    <DialogContent>
        @if (_order == null || _dto == null)
        {
            <MudProgressCircular Color="Color.Primary" Class="ma-auto" />
        }
        else
        {
            <MudForm @ref="@_form" @bind-IsValid="@_isValid" @bind-Errors="@_errors">
                <MudStack Spacing="3">
                    <!-- Informações do Aparelho (Read-only) -->
                    <MudPaper Class="pa-3" Elevation="0" Style="background: #f5f5f5;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Aparelho (não editável)</MudText>
                        <MudText Typo="Typo.body2">
                            @if (!string.IsNullOrEmpty(_order.DeviceBrand) || !string.IsNullOrEmpty(_order.DeviceModel))
                            {
                                <text>@_order.DeviceBrand @_order.DeviceModel</text>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </MudText>
                        @if (!string.IsNullOrEmpty(_order.SerialNumber))
                        {
                            <MudText Typo="Typo.body2">Serial: @_order.SerialNumber</MudText>
                        }
                    </MudPaper>

                    <!-- Status -->
                    <MudSelect T="string" Label="Status" @bind-Value="_dto.Status"
                            Variant="Variant.Outlined" Dense="true" Required="true">
                        <MudSelectItem T="string" Value="@("Open")">Aberto</MudSelectItem>
                        <MudSelectItem T="string" Value="@("InProgress")">Em Andamento</MudSelectItem>
                        <MudSelectItem T="string" Value="@("WaitingCustomer")">Aguardando Cliente</MudSelectItem>
                        <MudSelectItem T="string" Value="@("WaitingParts")">Aguardando Peças</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Completed")">Concluído</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Delivered")">Entregue</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Cancelled")">Cancelado</MudSelectItem>
                    </MudSelect>

                    <!-- Datas -->
                    <MudStack Row="true" Spacing="2">
                        <MudItem xs="6">
                            <DatePicker Label="Previsão Entrega" @bind-Date="_dto.EstimatedCompletionDate" Dense="true"/>
                        </MudItem>
                        <MudItem xs="6">
                            <DatePicker Label="Data Conclusão" @bind-Date="_dto.ActualCompletionDate" Dense="true"/>
                        </MudItem>
                    </MudStack>

                     <!-- Notas -->
                    <MudTextField T="string" Label="Notas Técnicas" @bind-Value="_dto.TechnicalNotes"
                                Placeholder="Observações internas para o técnico..."
                                Variant="Variant.Outlined" Dense="true" Multiline="true" Lines="3"/>
                    <MudTextField T="string" Label="Notas ao Cliente" @bind-Value="_dto.CustomerNotes"
                                Placeholder="Observações que aparecerão na ordem impressa..."
                                Variant="Variant.Outlined" Dense="true" Multiline="true" Lines="2"/>

                    <!-- Garantia -->
                    <MudStack Row="true" Spacing="2">
                        <MudItem xs="6">
                            <MudSelect T="string" Label="Garantia" @bind-Value="_dto.WarrantyType"
                                    Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem T="string" Value="@("")">Sem garantia</MudSelectItem>
                                <MudSelectItem T="string" Value="@("30 dias")">30 dias</MudSelectItem>
                                <MudSelectItem T="string" Value="@("90 dias")">90 dias</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="decimal?" Label="Desconto" @bind-Value="_dto.DiscountAmount"
                                        Variant="Variant.Outlined" Dense="true" Min="0"/>
                        </MudItem>
                    </MudStack>
                </MudStack>
            </MudForm>

            <!-- Anexos -->
            <MudPaper Class="pa-3 mt-4" Elevation="0" Style="background: #fafafa;">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Anexos</MudText>

                <!-- Upload -->
                <MudFileUpload T="IBrowserFile"
                               @bind-Files="_selectedFile"
                               Accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,.svg,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.json,.xml"
                               MaximumFileCount="1"
                               OnFilesChanged="OnFileSelected"
                               Hidden="@false"
                               InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                               InputStyle="opacity:0;">
                    <ActivatorContent>
                        <MudPaper Outlined="true" Class="pa-3 d-flex align-center" Style="cursor: pointer; border: 2px dashed #ccc;">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                            <MudText Typo="Typo.body2">
                                @if (_selectedFile != null)
                                {
                                    <text>@_selectedFile.Name (@FileFormatHelper.FormatFileSize(_selectedFile.Size))</text>
                                }
                                else
                                {
                                    <text>Clique para adicionar um arquivo</text>
                                }
                            </MudText>
                            @if (_selectedFile != null)
                            {
                                <MudSpacer />
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="UploadAttachment" Disabled="_uploading">
                                    @if (_uploading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <text>Enviar</text>
                                    }
                                </MudButton>
                            }
                        </MudPaper>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_fileSizeError)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                        Arquivo muito grande. Tamanho máximo: 10MB
                    </MudAlert>
                }

                <!-- Lista -->
                @if (_attachments.Any())
                {
                    <MudStack Spacing="1" Class="mt-2">
                        @foreach (var att in _attachments)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@FileFormatHelper.GetAttachmentIcon(att.ContentType)" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@att.OriginalFileName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@FileFormatHelper.FormatFileSize(att.FileSize)</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Href="@($"/api/ordens-servico/anexos/{att.Id}/download")"
                                                   Target="_blank" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteAttachment(att.Id))" />
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid)">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private string[] _errors = Array.Empty<string>();
    private ServiceOrderDto? _order;
    private UpdateServiceOrderDto? _dto;
    private List<ServiceOrderAttachmentDto> _attachments = new();
    private IBrowserFile? _selectedFile;
    private bool _uploading = false;
    private bool _fileSizeError = false;

    private const long MaxFileSize = 10L * 1024 * 1024; // 10MB

    protected override async Task OnParametersSetAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        try
        {
            _order = await ApiService.GetAsync<ServiceOrderDto>($"/api/ordens-servico/{OrderId}");
            if (_order != null)
            {
                _dto = new UpdateServiceOrderDto
                {
                    Status = _order.Status,
                    ProblemDescription = _order.ProblemDescription,
                    TechnicalNotes = _order.TechnicalNotes,
                    CustomerNotes = _order.CustomerNotes,
                    DiscountAmount = _order.DiscountAmount,
                    EstimatedCompletionDate = _order.EstimatedCompletionDate,
                    ActualCompletionDate = _order.ActualCompletionDate,
                    WarrantyType = _order.WarrantyType
                };
                _attachments = _order.Attachments?.ToList() ?? new List<ServiceOrderAttachmentDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar ordem: {ex.Message}", Severity.Error);
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _fileSizeError = _selectedFile.Size > MaxFileSize;
        StateHasChanged();
    }

    private async Task UploadAttachment()
    {
        if (_selectedFile == null) return;

        if (_fileSizeError)
        {
            Snackbar.Add("Arquivo muito grande. Tamanho máximo: 10MB", Severity.Error);
            return;
        }

        _uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_selectedFile.OpenReadStream(MaxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_selectedFile.ContentType);
            content.Add(fileContent, "file", _selectedFile.Name);

            var response = await ApiService.PostMultipartAsync($"/api/ordens-servico/{OrderId}/anexos", content);
            if (response.IsSuccessStatusCode)
            {
                var attachment = await response.Content.ReadFromJsonAsync<ServiceOrderAttachmentDto>();
                if (attachment != null)
                {
                    _attachments.Add(attachment);
                    Snackbar.Add("Anexo enviado com sucesso", Severity.Success);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro ao enviar anexo: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao enviar anexo");
            Snackbar.Add($"Erro ao enviar anexo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
            _selectedFile = null;
        }
    }

    private async Task DeleteAttachment(int attachmentId)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar exclusão",
            "Deseja realmente remover este anexo?",
            yesText: "Sim", cancelText: "Não");

        if (confirm != true) return;

        try
        {
            var response = await ApiService.DeleteAsync($"/api/ordens-servico/anexos/{attachmentId}");
            if (response.IsSuccessStatusCode)
            {
                _attachments.RemoveAll(a => a.Id == attachmentId);
                Snackbar.Add("Anexo removido com sucesso", Severity.Success);
            }
            else
            {
                Snackbar.Add("Erro ao remover anexo", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao remover anexo");
            Snackbar.Add($"Erro ao remover anexo: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form!.Validate();

        if (!_isValid || _dto == null)
            return;

        try
        {
            var response = await ApiService.PutAsync<ServiceOrderDto>($"/api/ordens-servico/{OrderId}", _dto);
            if (response != null)
            {
                Snackbar.Add($"Ordem {_order!.OrderNumber} atualizada com sucesso!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(response));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao atualizar ordem: {ex.Message}", Severity.Error);
        }
    }

    private string GetAttachmentIcon(string contentType) => FileFormatHelper.GetAttachmentIcon(contentType);
    private string FormatFileSize(long bytes) => FileFormatHelper.FormatFileSize(bytes);
}
